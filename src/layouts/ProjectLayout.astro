---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '@/styles/prose.css';
import { brand } from '@/brand';

interface Props {
  frontmatter?: {
    title: string;
    logline: string;
    form: string;
    status: string;
    date?: string;
    datePublished?: string;
    image?: ImageMetadata | string;
    socialImage?: ImageMetadata | string;
    tags?: string[];
  };
  pieces?: CollectionEntry<'essays'>[];
}

function urlOf(value: ImageMetadata | string | undefined): string | undefined {
  if (!value) return undefined;
  return typeof value === 'string' ? value : value.src;
}

const { frontmatter, pieces = [] } = Astro.props;
const title = frontmatter?.title ?? 'Project';
const logline = frontmatter?.logline ?? '';
const form = frontmatter?.form ?? 'other';
const status = frontmatter?.status ?? 'ideating';
const featureImage = frontmatter?.image;
const socialImage = urlOf(frontmatter?.socialImage) ?? urlOf(frontmatter?.image);
const date = frontmatter?.date;

const formLabel: Record<string, string> = {
  novel: 'Novel',
  novella: 'Novella',
  'short-story': 'Short story',
  'essay-collection': 'Essay collection',
  'long-essay': 'Long essay',
  memoir: 'Memoir',
  other: 'Project',
};
---

<BaseLayout
  title={title}
  description={logline}
  image={socialImage}
  type="article"
>
  <article class="project site-container">
    <header class="project-header">
      <p class="folio">
        <span>Project</span>
        {date && <><span aria-hidden="true">·</span><span>{date}</span></>}
      </p>
      <h1 class="project-title">{title}</h1>
      <p class="project-logline">{logline}</p>
      <p class="project-meta">
        <span class="folio">{formLabel[form] ?? 'Project'}</span>
        <span class={`status-pill status-pill--${status}`}>{status}</span>
      </p>
      <hr class="rule-accent" aria-hidden="true" />
    </header>

    {featureImage && (
      <figure class="project-feature">
        {typeof featureImage === 'string'
          ? <img src={featureImage} alt="" />
          : <Image src={featureImage} alt="" />
        }
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    {pieces.length > 0 && (
      <section class="project-pieces">
        <header class="pieces-header">
          <p class="folio">In this collection</p>
          <h2 class="pieces-title">Pieces</h2>
        </header>
        <ul class="pieces-list">
          {pieces.map((piece) => (
            <li>
              <a href={`/essays/${piece.id}`} class="piece-link">
                <span class="piece-date folio">{piece.data.date}</span>
                <span class="piece-title">{piece.data.title}</span>
                {piece.data.description && (
                  <span class="piece-dek">{piece.data.description}</span>
                )}
                {piece.data.originallyPublishedIn && (
                  <span class="piece-venue folio">
                    Originally in {piece.data.originallyPublishedIn.venue}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .project-header {
    max-width: var(--measure-reading);
    margin: 0 auto 3rem;
  }

  .project-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin: 0.75rem 0 1rem;
    font-variation-settings: "opsz" 144;
  }

  .project-logline {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.5;
    color: hsl(var(--ink));
    font-style: italic;
    margin: 0 0 1.5rem;
  }

  .project-meta {
    margin: 0 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-feature {
    max-width: 52rem;
    margin: 2rem auto 3rem;
  }

  .project-feature img {
    width: 100%;
    border: 1px solid hsl(var(--rule));
  }

  .folio {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }

  .project-pieces {
    max-width: var(--measure-reading);
    margin: 4rem auto 0;
  }

  .pieces-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 1.5rem;
    flex-wrap: wrap;
  }

  .pieces-title {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.005em;
    font-variation-settings: "opsz" 36;
  }

  .pieces-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pieces-list li {
    border-top: 1px solid hsl(var(--rule));
  }

  .pieces-list li:last-child {
    border-bottom: 1px solid hsl(var(--rule));
  }

  .piece-link {
    display: grid;
    grid-template-columns: 8rem 1fr;
    grid-template-areas:
      "date  title"
      "date  dek"
      "date  venue";
    gap: 0.25rem 1.25rem;
    padding: 1.1rem 0;
    color: hsl(var(--ink));
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .piece-link:hover {
    background: hsl(var(--paper-2) / 0.5);
  }

  .piece-date {
    grid-area: date;
    align-self: baseline;
    color: hsl(var(--ink-soft));
  }

  .piece-title {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: hsl(var(--ink));
    transition: color 0.15s ease;
    font-variation-settings: "opsz" 36;
  }

  .piece-link:hover .piece-title {
    color: hsl(var(--accent));
  }

  .piece-dek {
    grid-area: dek;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: hsl(var(--ink-soft));
    font-style: italic;
    line-height: 1.45;
  }

  .piece-venue {
    grid-area: venue;
    margin-top: 0.2rem;
    color: hsl(var(--accent));
    font-size: 0.7rem;
  }

  @media (max-width: 600px) {
    .piece-link {
      grid-template-columns: 1fr;
      grid-template-areas:
        "date"
        "title"
        "dek"
        "venue";
      gap: 0.3rem;
    }
  }
</style>
